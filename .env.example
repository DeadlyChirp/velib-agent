# Toutes les variables lues par le service, sans exception.
#
# Un test vérifie que ce fichier reste exhaustif : api/internal/config vérifie
# que chaque variable lue par le code apparaît ici. Une variable ajoutée au code
# et oubliée ici est une variable que personne ne découvre avant la production.
#
#   cp .env.example .env    puis renseigner OPENAI_API_KEY
#
# Les valeurs ci-dessous sont les défauts du code. Une ligne commentée signale
# une variable qui a un défaut utilisable tel quel.

# ── Modèle ───────────────────────────────────────────────────────────────────
#
# Choisi par variable d'environnement, comme le demande la spécification. N'importe quel
# fournisseur compatible OpenAI convient : le projet a été vérifié sur trois
# modèles de deux fournisseurs différents, sans une ligne de code spécifique.

MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=sk-remplacez-moi

# ⚠️ Une URL de base EXPLICITE, jamais vide.
#
# Le framework ne pose d'URL par défaut que pour ses variantes nommées
# (DeepSeek, Qwen, MiniMax, Kimi). Pour OpenAI, laisser ce champ vide ne pose
# aucune URL, et l'appel échoue sur « unsupported protocol scheme "" » — un
# message qui ne nomme pas ce qui manque.
OPENAI_BASE_URL=https://api.openai.com/v1

# Longueur du raisonnement. VIDE PAR DÉFAUT, et ce n'est pas un oubli : ce champ
# n'existe que chez les modèles raisonneurs (gpt-oss, o-series). L'envoyer à
# gpt-4o-mini produit une erreur au premier message, et un défaut qui ne
# fonctionne pas ne sert à rien.
#
# Mesuré sur gpt-oss-120b : « low » fait passer une réponse de 1066 ms / 201
# jetons à 587 ms / 98 jetons, sans perte de justesse. Les agrégations sont
# faites en Go : le modèle ne fait que choisir l'outil et rédiger.
REASONING_EFFORT=

# ── Autres fournisseurs, points d'entrée vérifiés un par un ──────────────────
#
# Chacun répond 401 ou 400 sur une clé invalide, jamais 404 : le point d'entrée
# existe bien. Vérifié le 05/09/2026.
#
#   Anthropic   MODEL_NAME=claude-opus-4-5
#               OPENAI_BASE_URL=https://api.anthropic.com/v1
#               Claude se branche sans toucher au code.
#
#   Gemini      MODEL_NAME=gemini-flash-latest
#               OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#               Clé gratuite sur aistudio.google.com/apikey, sans carte.
#               ⚠️ 20 requêtes par jour et PAR MODÈLE sur le palier gratuit.
#                  Le compteur étant par modèle, passer à
#                  gemini-flash-lite-latest redonne un quota neuf.
#               ⚠️ Préférer un nom en -latest : gemini-2.5-flash a été retiré
#                  aux nouveaux comptes, et l'erreur ne dit pas que le nom du
#                  modèle est en cause.
#
#   Cerebras    MODEL_NAME=gpt-oss-120b
#               OPENAI_BASE_URL=https://api.cerebras.ai/v1
#               Clé sur cloud.cerebras.ai. Le plus rapide du lot.
#
#   Mistral     MODEL_NAME=mistral-small-latest
#               OPENAI_BASE_URL=https://api.mistral.ai/v1
#
#   Groq        MODEL_NAME=openai/gpt-oss-120b
#               OPENAI_BASE_URL=https://api.groq.com/openai/v1
#               ⚠️ llama-3.3-70b-versatile a été retiré du catalogue.
#
#   OpenRouter  MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free
#               OPENAI_BASE_URL=https://openrouter.ai/api/v1
#
#   Together    MODEL_NAME=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free
#               OPENAI_BASE_URL=https://api.together.xyz/v1
#
#   Ollama      MODEL_NAME=qwen2.5:7b
#               OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#               OPENAI_API_KEY=ollama   (non vérifiée, mais non vide)

# ── Serveur HTTP ─────────────────────────────────────────────────────────────
#
# Adresse d'écoute de l'API À L'INTÉRIEUR du conteneur. Changer le port publié
# sur la machine se fait par API_PORT plus bas, pas ici.
# API_ADDR=:8080

# Défaut restrictif plutôt que « * ». Par le chemin nominal, le front appelle
# /api en relatif sur nginx : même origine, l'en-tête n'est jamais évalué. Un
# « * » n'aurait rien débloqué pour l'usage prévu, tout en ouvrant l'API à
# n'importe quelle page ouverte dans le navigateur.
CORS_ORIGINS=http://localhost:3000

# ── Base de données ──────────────────────────────────────────────────────────
#
# Fournie par le compose. À renseigner seulement pour lancer l'API hors Docker.
# POSTGRES_DSN=postgres://velib:velib@localhost:5432/velib?sslmode=disable

# ── Source Vélib' ────────────────────────────────────────────────────────────
#
# Les deux flux de données. Surchargeables pour pointer vers un jeu de données
# figé — pratique pour démontrer le service sans dépendre du réseau.
# VELIB_INFORMATION_URL=https://velib-metropole-opendata.smovengo.cloud/opendata/Velib_Metropole/station_information.json
# VELIB_STATUS_URL=https://velib-metropole-opendata.smovengo.cloud/opendata/Velib_Metropole/station_status.json

# Durée de validité du parc en mémoire. Le fichier amont annonce un ttl de
# 3600 s, mais la donnée bouge à la minute : 60 s est le compromis entre
# fraîcheur et respect d'un service public gratuit.
VELIB_CACHE_TTL=60s

# ── Ports publiés sur la machine ─────────────────────────────────────────────
#
# À changer si l'un d'eux est déjà occupé — un PostgreSQL local sur 5432 fait
# échouer `docker compose up` en entier, avec un message qui parle de port et
# pas de conflit.
# POSTGRES_PORT=5432
# API_PORT=8080
# WEB_PORT=3000

# ── Journalisation ───────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=text
