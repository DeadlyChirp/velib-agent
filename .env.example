# ── Modèle ───────────────────────────────────────────────────────────────────
# Le modèle est choisi par variable d'environnement, comme demandé par le sujet.
# N'importe quel fournisseur compatible OpenAI convient.

# OpenAI (défaut)
MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=sk-remplacez-moi
OPENAI_BASE_URL=

# Longueur du raisonnement, pour les modeles qui en font (gpt-oss, o-series).
# Mesure sur gpt-oss-120b : « low » fait passer une reponse de 1066 ms / 201
# jetons a 587 ms / 98 jetons, sans perte de justesse — les agregations sont
# faites en Go, le modele ne fait que choisir l'outil et rediger.
# Laisser VIDE pour les fournisseurs qui ne connaissent pas ce champ.
REASONING_EFFORT=low

# Groq (gratuit)  : MODEL_NAME=llama-3.3-70b-versatile
#                  OPENAI_BASE_URL=https://api.groq.com/openai/v1
#                  Cle gratuite et immediate sur console.groq.com/keys,
#                  sans carte bancaire. Le plus simple pour essayer.
# Gemini (gratuit): MODEL_NAME=gemini-2.0-flash
#                  OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                  Cle gratuite sur aistudio.google.com/apikey, sans carte.
# OpenRouter      : MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free
#                  OPENAI_BASE_URL=https://openrouter.ai/api/v1
#                  Les modeles suffixes « :free » ne coutent rien.
# Mistral        : MODEL_NAME=mistral-small-latest
#                  OPENAI_BASE_URL=https://api.mistral.ai/v1
# DeepSeek       : MODEL_NAME=deepseek-chat
#                  OPENAI_BASE_URL=https://api.deepseek.com/v1
# Ollama local   : MODEL_NAME=qwen2.5:7b
#                  OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#                  OPENAI_API_KEY=ollama   (non vérifiée, mais non vide)

# ── Base de données ──────────────────────────────────────────────────────────
# Fournie par le compose. À renseigner seulement pour lancer l'API hors Docker.
# POSTGRES_DSN=postgres://velib:velib@localhost:5432/velib?sslmode=disable

# ── Source Vélib' ────────────────────────────────────────────────────────────
# Durée de validité du parc en mémoire. Le fichier amont annonce un ttl de
# 3600 s mais la donnée bouge à la minute : 60 s est le compromis entre
# fraîcheur et respect d'un service public gratuit.
VELIB_CACHE_TTL=60s

# ── Ports publiés ────────────────────────────────────────────────────────────
# À changer si l'un d'eux est déjà occupé sur la machine — un PostgreSQL local
# sur 5432 fait échouer `docker compose up` en entier.
# POSTGRES_PORT=5432
# API_PORT=8080
# WEB_PORT=3000

# ── Divers ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=text
CORS_ORIGINS=http://localhost:3000
